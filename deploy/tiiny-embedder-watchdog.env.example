# tiiny-embedder-watchdog configuration
# Install to /etc/tiiny-embedder-watchdog.env  (chmod 600 — it can hold a token)

# --- Endpoints -------------------------------------------------------------
# ON-DEVICE: point these at localhost and your actual ports.
#   TIINY_MGMT=http://127.0.0.1:8800/api/v1
#   TIINY_EMBED_URL=http://127.0.0.1:8080/v1/embeddings
# FROM A HOST: use the device's stable API bridge (the model's own port can
# change on every restart, so prefer the gateway hostname over a raw port).
TIINY_MGMT=http://p8800.api.tiiny/api/v1
TIINY_EMBED_URL=http://api.tiiny/v1/embeddings

# The model to keep alive (the one you probe).
TIINY_MODEL=Qwen/Qwen3-Embedding-0.6B

# --- Auth ------------------------------------------------------------------
# Prefer the file form so the token never appears in `ps` output.
#TIINY_TOKEN=
#TIINY_TOKEN_FILE=/etc/tiiny-api-token

# --- Detection -------------------------------------------------------------
WD_INTERVAL=30          # seconds between probes
WD_FAILMAX=3            # consecutive failures before declaring a wedge
WD_PROBE_TIMEOUT=12     # per-probe timeout (s)

# --- Recovery --------------------------------------------------------------
WD_STOP_ALL=1           # 1 = stop ALL models (this is what actually clears it)
WD_SETTLE=5             # pause after stopping, before starting (s)
WD_RECOVER_TRIES=25     # health polls after restart
WD_RECOVER_WAIT=6       # seconds between health polls
WD_COOLDOWN=120         # min seconds between recovery attempts
WD_MAX_PER_HOUR=6       # thrash guard; if exceeded, log loudly and stop trying

# Safety: only treat a failing endpoint as a wedge if the DEVICE still answers.
# If the management API is unreachable too, the fault is the path (network /
# bridge / DNS) and stopping models would be a destructive false positive.
# Set to 0 only if this device genuinely has no management API.
WD_REQUIRE_MGMT=1
WD_MGMT_TIMEOUT=8       # reachability-check timeout (s)

# --- Behavior --------------------------------------------------------------
WD_DRY_RUN=0            # 1 = detect and log only, never stop/start anything
WD_HEARTBEAT=3600       # seconds between summary lines (0 disables)
#WD_LOG_FILE=           # optional extra log file; journald captures stdout anyway
