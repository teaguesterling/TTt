# --- Never commit: device credentials -------------------------------------
# The bearer token, and anything derived from pcsvr's auth_data.
auth_data/
*auth_key*
*.token

# --- Runtime state written by the tools themselves -------------------------
*.log
*.pid
wifi-trace*.csv
# pluckit's cache, dropped in whatever directory `ttt ask --code` is pointed at.
# Ignored by pluckit and squackit themselves; TTt creates one too, via squackit.
.pluckit.duckdb
.pluckit.duckdb.wal

# --- Capture / diagnostic bundles ------------------------------------------
tiiny-import-diag-*/
*-capture-*/

# --- Python bytecode --------------------------------------------------------
__pycache__/
*.pyc
